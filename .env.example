# 聊天服务端配置（复制为 .env.local 后填写）
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
# 当前网络需要代理时填写 HTTP/HTTPS CONNECT 代理，例如 http://127.0.0.1:7890
OPENAI_PROXY_URL=
# 仅在你完全信任自签名 HTTPS 代理时开启；正式环境优先使用有效证书
OPENAI_ALLOW_INSECURE_TLS=false

# 本地 API 服务默认配置
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8788
